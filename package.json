{
  "name": "prolazer-erp",
  "version": "1.3.27",
  "description": "Profesyonel Lazer Kesim Muhasebe ve Yönetim Sistemi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "npm run test:erp && npm run test:accounting && npm run test:operations && npm run test:startup && npm run test:site && npm run test:version && npm run test:ui && npm run test:volume && npm run test:packaging",
    "test:erp": "node test/sec_test.js",
    "test:accounting": "node test/accounting_end_to_end_test.js",
    "test:operations": "node test/operational_controls_test.js",
    "test:startup": "node test/startup_persistence_test.js",
    "test:site": "node test/site_weight_test.js",
    "test:version": "node test/version_test.js",
    "test:ui": "node test/ui_workflow_test.js",
    "test:volume": "node test/high_volume_ui_test.js",
    "test:packaging": "node test/packaging_integrity_test.js",
    "build:mac": "electron-builder --mac -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.gatekeeperAssess=false -c.mac.notarize=false",
    "build:mac:release": "node scripts/verify-mac-release.js && electron-builder --mac",
    "clean:old-builds": "node scripts/clean-old-builds.js --apply",
    "build:win": "electron-builder --win",
    "build:win:x64": "electron-builder --win --x64"
  },
  "author": "Mert",
  "license": "ISC",
  "devDependencies": {
    "electron": "^42.8.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1"
  },
  "build": {
    "appId": "com.mert.aklazer",
    "productName": "AK LAZER ERP",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "app.js",
      "main.js",
      "preload.js",
      "style.css",
      "assets/ak-lazer-icon-ui.png",
      "assets/ak-lazer-logo-ui.png",
      "assets/ak-lazer-logo-wide.png",
      "build/icon.png",
      "build/icon.icns",
      "build/icon.ico",
      "node_modules/@fortawesome/fontawesome-free/css/all.min.css",
      "node_modules/@fortawesome/fontawesome-free/webfonts/*.woff2",
      "node_modules/chart.js/dist/chart.umd.min.js"
    ],
    "extraResources": [
      {
        "from": "README.TXT",
        "to": "README.TXT"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": true,
      "notarize": true
    },
    "dmg": {
      "title": "AK LAZER ERP ${version}",
      "artifactName": "AK_LAZER_ERP_Kurulum.${ext}",
      "background": "build/dmg-background.png",
      "iconSize": 96,
      "iconTextSize": 13,
      "contents": [
        {
          "x": 165,
          "y": 263
        },
        {
          "x": 495,
          "y": 263,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "${productName} Setup ${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "chart.js": "^4.5.1"
  }
}
