{
  "name": "prolazer-erp",
  "version": "1.5.24",
  "description": "Profesyonel Lazer Kesim Muhasebe ve Yönetim Sistemi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "npm run test:erp && npm run test:accounting && npm run test:operations && npm run test:startup && npm run test:version && npm run test:ui && npm run test:workspace && npm run test:invoices && npm run test:print && npm run test:volume && npm run test:packaging && npm run test:finance && npm run test:safety && npm run test:quick-sales && npm run test:sheet-cut && npm run test:sheet-purchase && npm run test:audit",
    "test:erp": "node test/sec_test.js",
    "test:accounting": "node test/accounting_end_to_end_test.js",
    "test:operations": "node test/operational_controls_test.js",
    "test:startup": "node test/startup_persistence_test.js",
    "test:version": "node test/version_test.js",
    "test:ui": "node test/ui_workflow_test.js",
    "test:volume": "node test/high_volume_ui_test.js",
    "test:packaging": "node test/packaging_integrity_test.js",
    "build:mac": "electron-builder --mac -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.gatekeeperAssess=false -c.mac.notarize=false",
    "build:mac:release": "node scripts/verify-mac-release.js && electron-builder --mac",
    "clean:old-builds": "node scripts/clean-old-builds.js --apply",
    "build:win": "electron-builder --win",
    "build:win:x64": "electron-builder --win --x64",
    "test:workspace": "node test/workspace_design_test.js",
    "test:print": "node test/print_documents_test.js && node test/account_correction_print_test.js && node test/cari_identity_statement_test.js && node test/print_design_test.js",
    "test:invoices": "node test/invoice_integrity_test.js",
    "test:finance": "node test/finance_followup_test.js && node test/backup_status_test.js && node test/backup_ipc_test.js",
    "test:safety": "node test/desktop_instance_test.js && node test/transaction_replay_test.js",
    "test:quick-sales": "node test/quick_sales_test.js && node test/quick_sale_cut_test.js",
    "test:sheet-cut": "node test/sheet_cut_test.js && node test/sheet_weight_test.js && node test/kg_cost_test.js && node test/stock_identity_test.js && node test/readable_codes_test.js && node test/stock_consistency_test.js && node test/stock_ledger_test.js",
    "test:sheet-purchase": "node test/sheet_purchase_test.js",
    "test:audit": "node test/audit_fixes_test.js && node test/audit_fixes_2_test.js"
  },
  "author": "Mert",
  "license": "ISC",
  "devDependencies": {
    "electron": "^42.8.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1"
  },
  "build": {
    "appId": "com.mert.aklazer",
    "productName": "AK LAZER ERP",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "app.js",
      "main.js",
      "backup-status.js",
      "preload.js",
      "style.css",
      "assets/ak-lazer-icon-ui.png",
      "assets/ak-lazer-logo-ui.png",
      "assets/ak-lazer-logo-wide.png",
      "build/icon.png",
      "build/icon.icns",
      "build/icon.ico",
      "node_modules/@fortawesome/fontawesome-free/css/all.min.css",
      "node_modules/@fortawesome/fontawesome-free/webfonts/*.woff2",
      "node_modules/chart.js/dist/chart.umd.min.js"
    ],
    "extraResources": [
      {
        "from": "README.TXT",
        "to": "README.TXT"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": true,
      "notarize": true
    },
    "dmg": {
      "title": "AK LAZER ERP ${version}",
      "artifactName": "AK_LAZER_ERP_Kurulum.${ext}",
      "background": "build/dmg-background.png",
      "iconSize": 88,
      "iconTextSize": 13,
      "contents": [
        {
          "x": 155,
          "y": 234
        },
        {
          "x": 445,
          "y": 234,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 600,
        "height": 400
      }
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "${productName} Setup ${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "chart.js": "^4.5.1"
  }
}
